    "behavior.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معدل محاكاة النشاط عند عدم وجود إدخال من الماوس أو لوحة المفاتيح."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak často simulovat aktivitu, když není používána myš ani klávesnice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft Aktivität simuliert wird, wenn keine Maus- oder Tastatureingabe erfolgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often to simulate activity when there’s no mouse or keyboard input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué frecuencia simular actividad cuando no hay interacción con el mouse ni el teclado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فاصله شبیه‌سازی فعالیت هنگام نبود ورودی ماوس یا صفحه‌کلید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence de simulation de l’activité en l’absence de saisie avec la souris ou le clavier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תדירות הדמיית הפעילות כשאין קלט מהעכבר או מהמקלדת."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seberapa sering aktivitas disimulasikan saat tidak ada input mouse atau papan ketik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenza con cui simulare l’attività in assenza di input dal mouse o dalla tastiera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスやキーボードの入力がないときに操作をシミュレートする間隔を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스나 키보드 입력이 없을 때 활동을 시뮬레이션할 빈도입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe vaak activiteit wordt gesimuleerd wanneer er geen muis- of toetsenbordinvoer is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Częstotliwość symulowania aktywności przy braku użycia myszy lub klawiatury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequência de simulação de atividade quando não há interação com o mouse ou teclado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât de des se simulează activitatea când nu există acțiuni de la mouse sau tastatură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как часто имитировать активность, когда нет ввода с мыши и клавиатуры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare veya klavye girişi olmadığında etkinliğin ne sıklıkla taklit edileceği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як часто імітувати активність, коли немає введення з миші чи клавіатури."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tần suất mô phỏng hoạt động khi không có thao tác chuột hoặc bàn phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有鼠标或键盘输入时模拟活动的频率。"
          }
        }
      }
    },

    "behavior.presence.caption_list": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulate activity only while at least one app from the list below is running. Otherwise ZeroAway waits and doesn’t move the cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имитировать активность только пока запущено хотя бы одно приложение из списка ниже. Иначе — ожидание, курсор не двигается."
          }
        }
      }
    },
    "behavior.presence.caption_settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulate activity only while at least one app from the Presence tab is running. Otherwise ZeroAway waits and doesn’t move the cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имитировать активность только пока запущено хотя бы одно приложение из вкладки «Присутствие». Иначе — ожидание, курсор не двигается."
          }
        }
      }
    },
    "behavior.presence.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while an app is running"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только при запущенном приложении"
          }
        }
      }
    },
    "behavior.resume_session": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume session on launch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновлять сессию при запуске"
          }
        }
      }
    },
    "behavior.resume_session.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a session was active when ZeroAway quit, start it again. Timed sessions keep their original end time."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сессия была активна при выходе, снова включить её. Для сессий с таймером сохраняется исходное время окончания."
          }
        }
      }
    },
    "behavior.schedule.caption_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs whenever a session is on in the menu bar — no day or hour limits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает всегда, пока сессия включена в строке меню — без ограничения по дням и часам."
          }
        }
      }
    },
    "behavior.schedule.caption_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs only on the selected days and hours. Configure this in the Schedule tab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает только в выбранные дни и часы. Настройка — во вкладке «Расписание»."
          }
        }
      }
    },
    "behavior.schedule.title": {

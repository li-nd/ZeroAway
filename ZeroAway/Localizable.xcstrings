    "stats.disabled.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل الجمع أعلاه لبدء إنشاء سجل خاص لجلساتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnutím shromažďování výše začnete vytvářet soukromou historii svých relací."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie oben die Erfassung, um einen privaten Verlauf Ihrer Sitzungen anzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on collection above to start building a private history of your sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la recopilación arriba para comenzar a crear un historial privado de tus sesiones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ایجاد تاریخچه خصوصی نشست‌ها، جمع‌آوری را در بالا روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la collecte ci-dessus pour créer un historique privé de vos sessions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו את האיסוף למעלה כדי להתחיל ליצור היסטוריה פרטית של ההפעלות שלכם."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan pengumpulan di atas untuk mulai membuat riwayat pribadi sesi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la raccolta qui sopra per creare una cronologia privata delle tue sessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の収集をオンにすると、セッションの非公開履歴が記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 세션 기록을 쌓으려면 위에서 수집을 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de verzameling hierboven in om een privégeschiedenis van je sessies op te bouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz zbieranie powyżej, aby zacząć tworzyć prywatną historię sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a coleta acima para começar a criar um histórico privado das suas sessões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează colectarea de mai sus pentru a începe un istoric privat al sesiunilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите сбор выше, чтобы вести приватную историю сессий."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumlarınızın özel geçmişini oluşturmaya başlamak için yukarıdaki toplamayı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть збір вище, щоб почати вести приватну історію сеансів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật tính năng thu thập ở trên để bắt đầu tạo lịch sử riêng tư cho các phiên của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启上方的收集功能，开始建立仅供你查看的会话历史记录。"
          }
        }
      }
    },

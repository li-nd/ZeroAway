    "presence.gate.many %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيد التشغيل: %@ — تحقق الشرط"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuštěné: %@ — podmínka splněna"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeführt: %@ – Bedingung erfüllt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running: %@ — condition met"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En ejecución: %@ — condición cumplida"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال اجرا: %@ — شرط برقرار است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours d’exécution : %@ — condition remplie"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פועלים: %@ — התנאי מתקיים"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan: %@ — syarat terpenuhi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In esecuzione: %@ — condizione soddisfatta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中：%@ — 条件を満たしています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중: %@ — 조건 충족"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actief: %@ — aan voorwaarde voldaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działają: %@ — warunek spełniony"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em execução: %@ — condição atendida"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează: %@ — condiție îndeplinită"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущено: %@ — условие выполнено"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışıyor: %@ — koşul karşılandı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущено: %@ — умову виконано"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chạy: %@ — đã đáp ứng điều kiện"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在运行：%@ — 条件已满足"
          }
        }
      }
    },

    "schedule.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد أوقات تشغيل ZeroAway. ويجب أيضًا تشغيل جلسة من شريط القوائم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezuje dobu, kdy ZeroAway běží. Relace v řádku nabídek musí být zapnutá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wann ZeroAway ausgeführt wird. Eine Menüleistensitzung muss weiterhin aktiviert sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits when ZeroAway runs. A menu bar session must still be turned on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita cuándo se ejecuta ZeroAway. Aun así, debe haber una sesión activa en la barra de menús."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان اجرای ZeroAway را محدود می‌کند. نشست نوار منو همچنان باید روشن باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite les périodes d’exécution de ZeroAway. Une session doit tout de même être activée dans la barre des menus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגביל את המועדים שבהם ZeroAway פועל. עדיין יש להפעיל הפעלה בשורת התפריטים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatasi waktu ZeroAway berjalan. Sesi bar menu tetap harus dinyalakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita gli orari di esecuzione di ZeroAway. Una sessione deve comunque essere attivata dalla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAwayを実行する時間帯を制限します。メニューバーのセッションもオンにする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway 실행 시간을 제한합니다. 메뉴 막대 세션도 켜져 있어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beperkt wanneer ZeroAway actief is. Een menubalksessie moet nog steeds zijn ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicza czas działania ZeroAway. Sesja na pasku menu nadal musi być włączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita quando o ZeroAway funciona. Ainda é necessário ativar uma sessão na barra de menus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitează perioadele în care rulează ZeroAway. Trebuie activată și o sesiune din bara de meniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничивает работу ZeroAway заданными часами. Сессия в строке меню всё равно должна быть включена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway’in ne zaman çalışacağını sınırlar. Menü çubuğu oturumu yine de açık olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмежує час роботи ZeroAway. Сеанс у смузі меню все одно має бути ввімкнений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn thời điểm ZeroAway chạy. Một phiên trên thanh menu vẫn phải được bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制 ZeroAway 的运行时间。仍需开启菜单栏会话。"
          }
        }
      }
    },

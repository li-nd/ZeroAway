          "stringUnit": {
            "state": "translated",
            "value": "نشست‌های ۱، ۴ یا ۸ ساعته زمان‌بندی را نادیده می‌گیرند و تا پایان زمان‌سنج اجرا می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions de 1, 4 ou 8 heures ignorent les horaires et restent actives jusqu’à la fin du minuteur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלות של שעה, 4 או 8 שעות מתעלמות מלוח הזמנים ופועלות עד שהטיימר מסתיים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi 1, 4, atau 8 jam mengabaikan jadwal dan berjalan hingga pewaktu berakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni da 1, 4 o 8 ore ignorano la pianificazione e proseguono fino alla scadenza del timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1、4、8時間のセッションはスケジュールを無視し、タイマーが終了するまで実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1, 4, 8시간 세션은 일정을 무시하고 타이머가 끝날 때까지 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessies van 1, 4 of 8 uur negeren het schema en blijven actief tot de timer afloopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje 1-, 4- lub 8-godzinne ignorują harmonogram i działają do upływu czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões de 1, 4 ou 8 horas ignoram os horários e continuam até o fim do temporizador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunile de 1, 4 sau 8 ore ignoră programul și rulează până la expirarea cronometrului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессии на 1, 4 или 8 часов игнорируют расписание и работают до конца таймера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1, 4 veya 8 saatlik oturumlar zamanlamayı yok sayar ve süre dolana kadar çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанси на 1, 4 або 8 годин ігнорують розклад і працюють до завершення таймера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phiên 1, 4 hoặc 8 giờ sẽ bỏ qua lịch biểu và chạy đến khi bộ hẹn giờ kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1、4 或 8 小时会话不受日程限制，将持续运行至计时结束。"
          }
        }
      }
    },

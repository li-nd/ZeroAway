    "stats.clear.confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا. سيُحذف سجل الجلسات بالكامل على هذا الـ Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto akci nelze vrátit zpět. Veškerá historie relací na tomto Macu bude smazána."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann nicht rückgängig gemacht werden. Der gesamte Sitzungsverlauf auf diesem Mac wird gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. All session history on this Mac will be deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer. Se eliminará todo el historial de sesiones de esta Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار قابل بازگشت نیست. تمام تاریخچه نشست‌ها در این Mac حذف می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Tout l’historique des sessions de ce Mac sera supprimé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לבטל פעולה זו. כל היסטוריית ההפעלות ב-Mac הזה תימחק."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini tidak dapat dibatalkan. Semua riwayat sesi di Mac ini akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione non può essere annullata. Tutta la cronologia delle sessioni su questo Mac verrà eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。このMac上のすべてのセッション履歴が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 취소할 수 없습니다. 이 Mac의 모든 세션 기록이 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt. De volledige sessiegeschiedenis op deze Mac wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej czynności nie można cofnąć. Cała historia sesji na tym Macu zostanie usunięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não pode ser desfeita. Todo o histórico de sessões deste Mac será apagado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această acțiune nu poate fi anulată. Întregul istoric al sesiunilor de pe acest Mac va fi șters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие нельзя отменить. Вся история сессий на этом Mac будет удалена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem geri alınamaz. Bu Mac’teki tüm oturum geçmişi silinecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю дію не можна скасувати. Усю історію сеансів на цьому Mac буде видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tác thao tác này. Toàn bộ lịch sử phiên trên máy Mac này sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。此 Mac 上的所有会话历史记录都将被删除。"
          }
        }
      }
    },

    "presence.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيقات المطلوب تتبعها (Slack وTeams وما شابه) ومتى ينبغي لـ ZeroAway محاكاة النشاط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace ke sledování (Slack, Teams a podobné) a podmínky, za kterých má ZeroAway simulovat aktivitu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu überwachende Apps (Slack, Teams und ähnliche) und wann ZeroAway Aktivität simulieren soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps to track (Slack, Teams, and similar) and when ZeroAway should simulate activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps para monitorear (Slack, Teams y similares) y cuándo debe simular actividad ZeroAway."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌های قابل پایش (Slack، Teams و مشابه) و زمان شبیه‌سازی فعالیت توسط ZeroAway."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps à suivre (Slack, Teams et similaires) et conditions de simulation d’activité par ZeroAway."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים למעקב (Slack, Teams ודומיהם) והמועד שבו ZeroAway ידמה פעילות."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang dilacak (Slack, Teams, dan sejenisnya) serta kapan ZeroAway menyimulasikan aktivitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App da monitorare (Slack, Teams e simili) e quando ZeroAway deve simulare l’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監視するアプリ（Slack、Teamsなど）と、ZeroAwayが操作をシミュレートする条件を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적할 앱(Slack, Teams 등)과 ZeroAway가 활동을 시뮬레이션할 조건입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps om te volgen (Slack, Teams en vergelijkbare apps) en wanneer ZeroAway activiteit moet simuleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorowane aplikacje (Slack, Teams i podobne) oraz warunki symulowania aktywności przez ZeroAway."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps a monitorar (Slack, Teams e similares) e quando o ZeroAway deve simular atividade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicații de urmărit (Slack, Teams și altele similare) și când să simuleze ZeroAway activitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список приложений (Slack, Teams и аналоги) и условие, когда ZeroAway имитирует активность."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlenecek uygulamalar (Slack, Teams ve benzerleri) ve ZeroAway’in etkinliği ne zaman taklit edeceği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми для відстеження (Slack, Teams тощо) та умови імітації активності в ZeroAway."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng cần theo dõi (Slack, Teams và ứng dụng tương tự) cùng thời điểm ZeroAway nên mô phỏng hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要跟踪的 App（Slack、Teams 等）以及 ZeroAway 模拟活动的条件。"
          }
        }
      }
    },

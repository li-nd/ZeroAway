          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز شناسه بسته‌ای نیست — از برنامه‌های در حال اجرا اضافه کنید یا دستی وارد کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun identifiant de paquet — ajoutez-en depuis les apps ouvertes ou saisissez-les manuellement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין מזהי חבילה — הוסיפו מיישומים פועלים או הזינו ידנית."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ID Bundel—tambahkan dari app yang berjalan atau masukkan secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun Bundle ID — aggiungilo dalle app in esecuzione o inseriscilo manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle IDがありません。起動中のアプリから追加するか、手動で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 번들 ID가 없습니다. 실행 중인 앱에서 추가하거나 직접 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen bundel-ID’s — voeg ze toe vanuit actieve apps of voer ze handmatig in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak identyfikatorów pakietu — dodaj je z działających aplikacji lub wprowadź ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há IDs de pacote — adicione a partir dos apps em execução ou insira manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun ID de pachet — adaugă din aplicațiile care rulează sau introdu manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет Bundle ID — добавьте из запущенных или вручную."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz Paket Kimliği yok — çalışan uygulamalardan ekleyin veya elle girin."

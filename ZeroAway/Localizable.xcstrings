    "behavior.resume_session.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت جلسة نشطة عند إنهاء ZeroAway، فابدأها مجددًا. تحتفظ الجلسات المؤقتة بوقت انتهائها الأصلي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud byla při ukončení ZeroAway aktivní relace, znovu ji spustit. Časované relace zachovají původní čas ukončení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "War beim Beenden von ZeroAway eine Sitzung aktiv, wird sie erneut gestartet. Bei zeitlich begrenzten Sitzungen bleibt die ursprüngliche Endzeit erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a session was active when ZeroAway quit, start it again. Timed sessions keep their original end time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si había una sesión activa al cerrar ZeroAway, la inicia de nuevo. Las sesiones con temporizador conservan su hora de finalización original."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر هنگام خروج از ZeroAway نشستی فعال بود، دوباره آن را آغاز می‌کند. نشست‌های زمان‌دار همان زمان پایان قبلی را حفظ می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une session était active à la fermeture de ZeroAway, la relancer. Les sessions minutées conservent leur heure de fin initiale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם הפעלה הייתה פעילה בעת סגירת ZeroAway, היא תתחיל שוב. הפעלות מתוזמנות שומרות על שעת הסיום המקורית שלהן."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika sesi aktif saat ZeroAway ditutup, mulai lagi sesi tersebut. Sesi berwaktu tetap menggunakan waktu selesai semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se una sessione era attiva alla chiusura di ZeroAway, la riavvia. Le sessioni temporizzate mantengono l’ora di fine originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAwayの終了時にセッションが有効だった場合、再開します。時間指定セッションは元の終了時刻を維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway 종료 시 세션이 활성 상태였다면 다시 시작합니다. 시간제 세션은 원래 종료 시간을 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een sessie actief was toen ZeroAway werd gestopt, start deze dan opnieuw. Sessies met een timer behouden hun oorspronkelijke eindtijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli podczas zamykania ZeroAway sesja była aktywna, uruchom ją ponownie. Sesje czasowe zachowują pierwotny czas zakończenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se havia uma sessão ativa ao encerrar o ZeroAway, inicia-a novamente. Sessões temporizadas mantêm o horário de término original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă era activă o sesiune când ZeroAway s-a închis, o pornește din nou. Sesiunile cronometrate păstrează ora inițială de încheiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сессия была активна при выходе, снова включить её. Для сессий с таймером сохраняется исходное время окончания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway kapatıldığında bir oturum etkinse yeniden başlatır. Süreli oturumların özgün bitiş zamanı korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо під час завершення ZeroAway був активний сеанс, запустити його знову. Сеанси з таймером зберігають початковий час завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu một phiên đang hoạt động khi ZeroAway thoát, hãy khởi động lại phiên đó. Các phiên hẹn giờ vẫn giữ thời điểm kết thúc ban đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 ZeroAway 退出时会话仍处于活动状态，则重新启动该会话。定时会话会保留原结束时间。"
          }
        }
      }
    },
    "behavior.schedule.caption_off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل كلما كانت جلسة شريط القوائم مفعّلة، بلا قيود على الأيام أو الساعات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží vždy, když je relace v řádku nabídek zapnutá — bez omezení dnů či hodin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird immer ausgeführt, wenn eine Sitzung in der Menüleiste aktiv ist – ohne Einschränkung nach Tag oder Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs whenever a session is on in the menu bar — no day or hour limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta cuando hay una sesión activa en la barra de menús, sin límites de días ni horarios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر زمان نشست نوار منو روشن باشد اجرا می‌شود؛ بدون محدودیت روز یا ساعت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute dès qu’une session est active dans la barre des menus, sans restriction de jour ni d’heure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פועל בכל פעם שהפעלה מופעלת בשורת התפריטים — ללא הגבלות יום או שעה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan setiap kali sesi aktif di bar menu—tanpa batasan hari atau jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona ogni volta che una sessione è attiva nella barra dei menu, senza limiti di giorni o orari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーでセッションがオンの間は、曜日や時間の制限なく実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 세션이 켜져 있으면 요일이나 시간 제한 없이 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt uitgevoerd wanneer een sessie in de menubalk actief is, zonder beperkingen voor dagen of uren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa, gdy sesja jest włączona na pasku menu — bez ograniczeń dni ani godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É executado sempre que uma sessão está ativa na barra de menus, sem limites de dias ou horários."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează oricând este activă o sesiune din bara de meniu, fără limite de zi sau oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает всегда, пока сессия включена в строке меню — без ограничения по дням и часам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğunda bir oturum açıkken gün veya saat sınırı olmadan çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює щоразу, коли сеанс увімкнено в смузі меню, без обмежень за днями чи годинами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy bất cứ khi nào một phiên được bật trên thanh menu — không giới hạn ngày hoặc giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要菜单栏中的会话已开启，就会运行，不受日期或时间限制。"
          }
        }
      }
    },
    "behavior.schedule.caption_on": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل فقط في الأيام والساعات المحددة. اضبط ذلك في علامة تبويب الجدول."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží pouze ve vybrané dny a hodiny. Nastavte je na panelu Plán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur an den ausgewählten Tagen und zu den ausgewählten Uhrzeiten ausgeführt. Die Konfiguration erfolgt im Tab „Zeitplan“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs only on the selected days and hours. Configure this in the Schedule tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta solo en los días y horarios seleccionados. Configúralo en la pestaña Horario."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط در روزها و ساعت‌های انتخابی اجرا می‌شود. آن را در زبانه «زمان‌بندی» تنظیم کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute uniquement aux jours et heures sélectionnés. Configurez-les dans l’onglet Horaires."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פועל רק בימים ובשעות שנבחרו. ניתן להגדיר זאת בכרטיסייה לוח זמנים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan hanya pada hari dan jam yang dipilih. Atur di tab Jadwal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona solo nei giorni e negli orari selezionati. Configurali nella sezione Pianificazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した曜日と時間帯のみ実行します。「スケジュール」タブで設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 요일과 시간에만 실행됩니다. 일정 탭에서 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt alleen uitgevoerd op de geselecteerde dagen en uren. Configureer dit in het tabblad Schema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa tylko w wybrane dni i godziny. Skonfiguruj je na karcie Harmonogram."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É executado apenas nos dias e horários selecionados. Configure na aba Horários."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează doar în zilele și orele selectate. Configurează-le în fila Program."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает только в выбранные дни и часы. Настройка — во вкладке «Расписание»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçili gün ve saatlerde çalışır. Bunu Zamanlama sekmesinde yapılandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює лише у вибрані дні та години. Налаштуйте це на вкладці «Розклад»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ chạy vào những ngày và giờ đã chọn. Thiết lập trong tab Lịch biểu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在所选日期和时段运行。请在“日程”标签页中配置。"
          }
        }
      }
    },

    "system.hotkey.caption_on": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدّل جلسة شريط القوائم. يتطلب واحدًا على الأقل من ⌘ ⌃ ⌥."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepíná relaci v řádku nabídek. Vyžaduje alespoň jednu z kláves ⌘ ⌃ ⌥."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Menüleistensitzung um. Erfordert mindestens eine der Tasten ⌘ ⌃ ⌥."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggles the menu bar session. Requires at least one of ⌘ ⌃ ⌥."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva la sesión de la barra de menús. Requiere al menos una tecla ⌘ ⌃ ⌥."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشست نوار منو را روشن یا خاموش می‌کند. دست‌کم یکی از ⌘ ⌃ ⌥ لازم است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive la session de la barre des menus. Nécessite au moins une touche parmi ⌘ ⌃ ⌥."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל או משהה את ההפעלה בשורת התפריטים. נדרש לפחות אחד מהמקשים ⌘ ⌃ ⌥."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengaktifkan atau menonaktifkan sesi bar menu. Memerlukan setidaknya salah satu dari ⌘ ⌃ ⌥."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva la sessione nella barra dei menu. Richiede almeno uno tra ⌘ ⌃ ⌥."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのセッションを切り替えます。⌘、⌃、⌥のいずれかが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 세션을 켜거나 끕니다. ⌘ ⌃ ⌥ 중 하나 이상이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt de menubalksessie in of uit. Vereist minstens één van ⌘ ⌃ ⌥."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącza sesję na pasku menu. Wymaga co najmniej jednego z klawiszy ⌘ ⌃ ⌥."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna a sessão da barra de menus. Exige pelo menos uma das teclas ⌘ ⌃ ⌥."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comută sesiunea din bara de meniu. Necesită cel puțin una dintre tastele ⌘ ⌃ ⌥."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключает сессию в строке меню. Нужен хотя бы один из модификаторов ⌘ ⌃ ⌥."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu oturumunu açar veya kapatır. ⌘ ⌃ ⌥ tuşlarından en az biri gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикає сеанс у смузі меню. Потрібна принаймні одна з клавіш ⌘ ⌃ ⌥."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt phiên trên thanh menu. Cần ít nhất một phím ⌘ ⌃ ⌥."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换菜单栏会话。必须至少包含 ⌘、⌃ 或 ⌥ 中的一个。"
          }
        }
      }
    },
    "system.hotkey.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر لتعيين اختصار جديد. مفتاح Esc للإلغاء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím nastavíte novou zkratku. Klávesou Esc akci zrušíte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, um ein neues Tastenkürzel festzulegen. Esc bricht ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to set a new shortcut. Esc cancels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para definir un nuevo atajo. Esc cancela."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تنظیم میان‌بر جدید کلیک کنید. Esc لغو می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour définir un nouveau raccourci. Échap annule."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו כדי להגדיר קיצור דרך חדש. Esc מבטל."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik untuk mengatur pintasan baru. Esc untuk batal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per impostare una nuova abbreviazione. Esc annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックして新しいショートカットを設定します。Escでキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하여 새 단축키를 설정하세요. Esc를 누르면 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik om een nieuwe sneltoets in te stellen. Esc annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, aby ustawić nowy skrót. Esc anuluje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para definir um novo atalho. Esc cancela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fă clic pentru a seta o scurtătură nouă. Esc anulează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы задать новую комбинацию. Esc — отмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir kestirme ayarlamak için tıklayın. Esc vazgeçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть, щоб задати нове скорочення. Esc — скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm để đặt phím tắt mới. Nhấn Esc để hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以设置新快捷键。按 Esc 取消。"
          }
        }
      }
    },

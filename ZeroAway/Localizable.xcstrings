    "behavior.idle.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulate activity when there’s no input for longer than this duration."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имитировать активность, если нет ввода дольше указанного времени."
          }
        }
      }
    },
    "behavior.idle.title": {
      "extractionState": "manual",
      "localizations": {

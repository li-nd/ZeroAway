    "icons.catalog_url.sheet_caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه ZeroAway إلى أي ملف index.json يسرد إعدادات الأيقونات المسبقة. تعيد إعادة التعيين الكتالوج الرسمي."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasměrujte ZeroAway na libovolný soubor index.json se seznamem předvoleb ikon. Obnovením se vrátí oficiální katalog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verweisen Sie ZeroAway auf eine beliebige index.json, die Symbolvoreinstellungen auflistet. Durch Zurücksetzen wird der offizielle Katalog wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point ZeroAway at any index.json that lists icon presets. Reset restores the official catalog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a ZeroAway cualquier index.json que incluya preajustes de iconos. Restablecer recupera el catálogo oficial."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway را به هر index.json دارای فهرست پیش‌تنظیم‌های نماد متصل کنید. بازنشانی، کاتالوگ رسمی را برمی‌گرداند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez à ZeroAway un fichier index.json répertoriant des préréglages d’icônes. La réinitialisation restaure le catalogue officiel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להפנות את ZeroAway לכל קובץ index.json המפרט ערכות סמלים. האיפוס משחזר את הקטלוג הרשמי."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan ZeroAway ke index.json mana pun yang berisi daftar preset ikon. Atur Ulang akan memulihkan katalog resmi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a ZeroAway un file index.json che elenca i preset di icone. Il ripristino reimposta il catalogo ufficiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンプリセットを掲載した任意のindex.jsonをZeroAwayで使用できます。リセットすると公式カタログに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 프리셋을 나열하는 index.json으로 ZeroAway를 연결합니다. 재설정하면 공식 카탈로그로 복원됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat ZeroAway een willekeurig index.json-bestand gebruiken dat symboolvoorinstellingen bevat. Opnieuw instellen herstelt de officiële catalogus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skieruj ZeroAway do dowolnego pliku index.json zawierającego listę zestawów ikon. Wyzerowanie przywraca oficjalny katalog."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcione o ZeroAway a qualquer index.json que liste predefinições de ícones. Redefinir restaura o catálogo oficial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indică-i aplicației ZeroAway orice fișier index.json care listează presetări de pictograme. Resetarea restabilește catalogul oficial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите любой index.json со списком пресетов. «Сбросить» вернёт официальный каталог."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway’i simge hazır ayarlarını listeleyen herhangi bir index.json dosyasına yönlendirin. Sıfırlama, resmî kataloğu geri yükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть для ZeroAway будь-який index.json зі списком наборів іконок. Скидання відновить офіційний каталог."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trỏ ZeroAway đến tệp index.json bất kỳ có liệt kê các cấu hình sẵn biểu tượng. Đặt lại để khôi phục danh mục chính thức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可将 ZeroAway 指向任何列出图标预设的 index.json。还原后将恢复官方目录。"
          }
        }
      }
    },

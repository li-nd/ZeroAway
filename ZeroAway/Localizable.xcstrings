    "schedule.summary.disabled.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل ZeroAway في أي وقت أثناء تشغيل جلسة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway běží kdykoli, když je relace zapnutá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway wird jederzeit ausgeführt, solange eine Sitzung aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway runs anytime while a session is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway se ejecuta en cualquier momento mientras haya una sesión activa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway هر زمان که نشست روشن باشد اجرا می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway s’exécute à tout moment lorsqu’une session est active."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway פועל בכל עת כאשר הפעלה פעילה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway berjalan kapan saja selama sesi aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway funziona in qualsiasi momento mentre una sessione è attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションがオンの間、ZeroAwayはいつでも実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 켜져 있으면 ZeroAway가 언제든지 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway is altijd actief wanneer een sessie is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway działa zawsze, gdy sesja jest włączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ZeroAway funciona a qualquer hora enquanto uma sessão estiver ativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway rulează oricând este activă o sesiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway работает в любое время при включённой сессии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway, bir oturum açıkken her zaman çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway працює будь-коли, доки сеанс увімкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway chạy bất cứ lúc nào khi một phiên được bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

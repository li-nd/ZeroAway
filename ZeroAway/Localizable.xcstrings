    "behavior.idle.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاكاة النشاط عند عدم وجود إدخال لمدة أطول من هذه."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulovat aktivitu, pokud po tuto dobu nedojde k žádnému vstupu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität simulieren, wenn länger als diese Dauer keine Eingabe erfolgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulate activity when there’s no input for longer than this duration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula actividad cuando no hay interacción durante más tiempo que este intervalo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی ورودی برای مدتی بیش از این زمان وجود ندارد، فعالیت را شبیه‌سازی می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simule une activité en l’absence de saisie pendant une durée supérieure à celle-ci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדמיית פעילות כשאין קלט למשך זמן ארוך יותר ממשך זה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulasikan aktivitas jika tidak ada input selama lebih dari durasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula l’attività quando non ci sono input per un periodo superiore a questa durata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間を超えて入力がない場合に操作をシミュレートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간보다 오래 입력이 없으면 활동을 시뮬레이션합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Simuleer activiteit wanneer er langer dan deze duur geen invoer is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symuluj aktywność po braku działań przez czas dłuższy niż podany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula atividade quando não há interação por mais tempo que esta duração."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulează activitatea când nu există nicio acțiune mai mult decât această durată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имитировать активность, если нет ввода дольше указанного времени."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu süreden daha uzun süre giriş olmadığında etkinliği taklit eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імітувати активність, якщо введення відсутнє довше за цей час."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô phỏng hoạt động khi không có thao tác nhập lâu hơn khoảng thời gian này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当超过此时长没有输入时模拟活动。"
          }
        }
      }
    },

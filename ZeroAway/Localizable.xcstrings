    "menubar.need_accessibility.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإعادة تعيين خمول النظام، اسمح لـ ZeroAway في تسهيلات الاستخدام."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li vynulovat dobu nečinnosti systému, povolte ZeroAway ve Zpřístupnění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie ZeroAway unter „Bedienungshilfen“, um die Systeminaktivität zurückzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To reset system idle, allow ZeroAway in Accessibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para reiniciar la inactividad del sistema, permite ZeroAway en Accesibilidad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای بازنشانی بی‌کاری سیستم، در «دسترسی‌پذیری» به ZeroAway اجازه دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour réinitialiser l’inactivité système, autorisez ZeroAway dans Accessibilité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לאפס את חוסר הפעילות של המערכת, יש לאפשר ל-ZeroAway גישה תחת ״נגישות״."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengatur ulang waktu diam sistem, izinkan ZeroAway di Aksesibilitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per azzerare l’inattività di sistema, consenti a ZeroAway l’accesso ad Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのアイドル状態をリセットするには、「アクセシビリティ」でZeroAwayを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 유휴 시간을 재설정하려면 손쉬운 사용에서 ZeroAway를 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta ZeroAway toe bij Toegankelijkheid om de systeeminactiviteit opnieuw in te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zerować bezczynność systemu, zezwól ZeroAway na dostęp do ułatwień dostępu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para zerar a inatividade do sistema, permita o ZeroAway em Acessibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a reseta inactivitatea sistemului, permite accesul ZeroAway la Accesibilitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы сбрасывать idle, разрешите ZeroAway в Универсальном доступе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin boşta kalma süresini sıfırlamak için Erişilebilirlik’te ZeroAway’e izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб скидати системну бездіяльність, надайте ZeroAway доступ до універсального доступу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đặt lại trạng thái không hoạt động của hệ thống, hãy cho phép ZeroAway trong Trợ năng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要重置系统闲置状态，请允许 ZeroAway 使用辅助功能。"
          }
        }
      }
    },

    "about.blurb": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أداة لشريط القوائم تحاكي نشاط الماوس كي لا يدخل Mac في وضع الخمول. تدعم الجداول الزمنية ومهلة الخمول والتشغيل فقط عند فتح تطبيقات محددة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroj v řádku nabídek, který simuluje aktivitu myši, aby Mac nepřešel do nečinnosti. Podporuje plán, časový limit nečinnosti a spuštění pouze při otevření vybraných aplikací."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Menüleistenprogramm, das Mausaktivität simuliert, damit der Mac nicht inaktiv wird. Unterstützt Zeitpläne, ein Inaktivitätslimit und die Ausführung nur, solange ausgewählte Apps geöffnet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu bar utility that simulates mouse activity so the Mac doesn’t go idle. Supports schedules, an idle timeout, and running only while selected apps are open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una utilidad de la barra de menús que simula actividad del mouse para que la Mac no entre en reposo. Admite horarios, un tiempo de inactividad y ejecución solo mientras ciertas apps estén abiertas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابزاری در نوار منو که فعالیت ماوس را شبیه‌سازی می‌کند تا Mac بی‌کار نشود. از زمان‌بندی، مهلت بی‌کاری و اجرا فقط هنگام باز بودن برنامه‌های انتخابی پشتیبانی می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un utilitaire de barre des menus qui simule une activité de la souris pour empêcher le Mac de se mettre en veille. Il prend en charge les horaires, un délai d’inactivité et l’exécution uniquement lorsque certaines apps sont ouvertes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי לשורת התפריטים המדמה פעילות עכבר כדי שה-Mac לא יעבור למצב לא פעיל. תומך בלוחות זמנים, בזמן קצוב לחוסר פעילות ובהפעלה רק כאשר יישומים נבחרים פתוחים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitas bar menu yang menyimulasikan aktivitas mouse agar Mac tidak memasuki mode diam. Mendukung jadwal, batas waktu diam, dan berjalan hanya saat app tertentu terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’utility per la barra dei menu che simula l’attività del mouse per evitare che il Mac diventi inattivo. Supporta pianificazioni, un timeout di inattività e l’esecuzione solo quando sono aperte le app selezionate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウス操作をシミュレートし、Macがアイドル状態になるのを防ぐメニューバーユーティリティです。スケジュール、アイドルタイムアウト、指定したアプリの起動中のみ実行する機能に対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 유휴 상태가 되지 않도록 마우스 활동을 시뮬레이션하는 메뉴 막대 유틸리티입니다. 일정, 유휴 시간 제한, 선택한 앱이 열려 있을 때만 실행하는 기능을 지원합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een menubalkhulpprogramma dat muisactiviteit simuleert zodat de Mac niet inactief wordt. Ondersteunt schema’s, een time-out voor inactiviteit en uitvoering alleen wanneer geselecteerde apps geopend zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzie paska menu, które symuluje aktywność myszy, aby Mac nie przechodził w stan bezczynności. Obsługuje harmonogramy, limit bezczynności i działanie tylko przy otwartych wybranych aplikacjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um utilitário da barra de menus que simula a atividade do mouse para evitar que o Mac fique inativo. Oferece horários, tempo limite de inatividade e execução apenas enquanto apps selecionados estiverem abertos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un utilitar pentru bara de meniu care simulează activitatea mouse-ului pentru ca Mac-ul să nu intre în repaus. Acceptă programări, un timp de inactivitate și rularea doar cât timp sunt deschise anumite aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утилита для строки меню: имитирует активность мыши, чтобы система не засыпала. Поддерживает расписание, время простоя и работу только при запущенных приложениях."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’in boşta kalmasını önlemek için fare etkinliğini taklit eden bir menü çubuğu uygulaması. Zamanlamaları, boşta kalma zaman aşımını ve yalnızca seçili uygulamalar açıkken çalışmayı destekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утиліта в смузі меню, яка імітує рух миші, щоб Mac не переходив у режим бездіяльності. Підтримує розклади, тайм-аут бездіяльності та роботу лише тоді, коли відкриті вибрані програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích thanh menu mô phỏng hoạt động chuột để máy Mac không chuyển sang trạng thái không hoạt động. Hỗ trợ lịch biểu, thời gian chờ khi không hoạt động và chỉ chạy khi các ứng dụng đã chọn đang mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款菜单栏工具，通过模拟鼠标活动防止 Mac 进入闲置状态。支持日程、闲置超时，以及仅在所选 App 运行时启用。"
          }
        }
      }
    },

    "system.language.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لغة واجهة ZeroAway. خيار النظام يطابق macOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk rozhraní ZeroAway. Volba Systém odpovídá nastavení macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberflächensprache für ZeroAway. „System“ verwendet die macOS-Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface language for ZeroAway. System matches macOS."
          }
        },

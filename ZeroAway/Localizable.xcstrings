    "stats.retention.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُزال الجلسات الأقدم تلقائيًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Starší relace se odstraňují automaticky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Sitzungen werden automatisch entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older sessions are removed automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones más antiguas se eliminan automáticamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشست‌های قدیمی‌تر خودکار حذف می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciennes sessions sont supprimées automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלות ישנות מוסרות אוטומטית."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi lama dihapus secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni meno recenti vengono rimosse automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いセッションは自動的に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 세션은 자동으로 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudere sessies worden automatisch verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starsze sesje są usuwane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões mais antigas são removidas automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiunile mai vechi sunt eliminate automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более старые сессии удаляются автоматически."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski oturumlar otomatik olarak kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старіші сеанси видаляються автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phiên cũ hơn sẽ tự động bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较早的会话会自动移除。"
          }
        }
      }
    },
    "stats.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل محلي اختياري للجلسات والتحريكات. لا تغادر أي بيانات هذا الـ Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelná místní historie relací a posunutí. Z tohoto Macu se nic neodesílá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionaler lokaler Verlauf von Sitzungen und Bewegungen. Nichts verlässt diesen Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional local history of sessions and nudges. Nothing leaves this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial local opcional de sesiones y movimientos. Nada sale de esta Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخچه محلی و اختیاری نشست‌ها و حرکت‌ها. هیچ داده‌ای از این Mac خارج نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique local facultatif des sessions et déplacements. Aucune donnée ne quitte ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היסטוריה מקומית אופציונלית של הפעלות והזזות. דבר אינו נשלח מה-Mac הזה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat lokal opsional untuk sesi dan gerakan. Tidak ada data yang keluar dari Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronologia locale facoltativa di sessioni e spostamenti. Nessun dato lascia questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションとカーソル移動の履歴をこのMacにのみ保存できます。外部には送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택적으로 세션과 커서 이동 기록을 이 Mac에만 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionele lokale geschiedenis van sessies en bewegingen. Niets verlaat deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalna lokalna historia sesji i ruchów kursora. Żadne dane nie opuszczają tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico local opcional de sessões e movimentos. Nada sai deste Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoric local opțional al sesiunilor și mișcărilor. Nimic nu părăsește acest Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательная локальная история сессий и срабатываний. Данные не покидают этот Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı yerel oturum ve hareket geçmişi. Hiçbir veri bu Mac’ten ayrılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язкова локальна історія сеансів і зсувів. Дані не залишають цей Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử cục bộ tùy chọn về các phiên và lần dịch chuyển. Không có dữ liệu nào rời khỏi máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的本地会话和微移历史记录。数据不会离开此 Mac。"
          }
        }
      }
    },

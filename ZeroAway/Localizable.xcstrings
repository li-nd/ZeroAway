    "behavior.presence.caption_list": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاكاة النشاط فقط أثناء تشغيل تطبيق واحد على الأقل من القائمة أدناه. وإلا ينتظر ZeroAway ولا يحرك المؤشر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulovat aktivitu, pouze když je spuštěna alespoň jedna aplikace ze seznamu níže. Jinak ZeroAway čeká a kurzor nepohybuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität nur simulieren, solange mindestens eine App aus der Liste unten ausgeführt wird. Andernfalls wartet ZeroAway und bewegt den Zeiger nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulate activity only while at least one app from the list below is running. Otherwise ZeroAway waits and doesn’t move the cursor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula actividad solo mientras se esté ejecutando al menos una app de la lista. De lo contrario, ZeroAway espera y no mueve el cursor."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط وقتی دست‌کم یکی از برنامه‌های فهرست زیر در حال اجراست، فعالیت را شبیه‌سازی می‌کند. در غیر این صورت ZeroAway منتظر می‌ماند و نشانگر را حرکت نمی‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simule une activité uniquement lorsqu’au moins une app de la liste ci-dessous est en cours d’exécution. Sinon, ZeroAway attend sans déplacer le pointeur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדמיית פעילות רק כאשר לפחות יישום אחד מהרשימה שלמטה פועל. אחרת ZeroAway ממתין ואינו מזיז את הסמן."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulasikan aktivitas hanya saat setidaknya satu app dari daftar di bawah sedang berjalan. Jika tidak, ZeroAway menunggu dan tidak menggerakkan kursor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula l’attività solo mentre è in esecuzione almeno un’app dell’elenco seguente. In caso contrario, ZeroAway attende e non sposta il cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のリストにあるアプリが1つ以上起動している間のみ操作をシミュレートします。それ以外はZeroAwayが待機し、カーソルを動かしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 목록의 앱 중 하나 이상이 실행 중일 때만 활동을 시뮬레이션합니다. 그렇지 않으면 ZeroAway가 대기하며 커서를 움직이지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Simuleer alleen activiteit wanneer minstens één app uit de onderstaande lijst actief is. Anders wacht ZeroAway en beweegt de aanwijzer niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symuluj aktywność tylko wtedy, gdy działa co najmniej jedna aplikacja z poniższej listy. W przeciwnym razie ZeroAway czeka i nie porusza kursorem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Simula atividade apenas enquanto pelo menos um app da lista abaixo estiver em execução. Caso contrário, o ZeroAway aguarda e não move o cursor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulează activitatea doar cât timp rulează cel puțin o aplicație din lista de mai jos. Altfel, ZeroAway așteaptă și nu mișcă cursorul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имитировать активность только пока запущено хотя бы одно приложение из списка ниже. Иначе — ожидание, курсор не двигается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinliği yalnızca aşağıdaki listeden en az bir uygulama çalışırken taklit eder. Aksi halde ZeroAway bekler ve imleci hareket ettirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імітувати активність, лише коли запущено принаймні одну програму зі списку нижче. Інакше ZeroAway очікує та не рухає курсор."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ mô phỏng hoạt động khi ít nhất một ứng dụng trong danh sách bên dưới đang chạy. Nếu không, ZeroAway sẽ chờ và không di chuyển con trỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当下方列表中至少有一个 App 正在运行时模拟活动。否则 ZeroAway 会等待且不移动光标。"
          }
        }
      }
    },

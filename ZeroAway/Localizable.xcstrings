    "behavior.nudge.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد وحدات البكسل لتحريك المؤشر ثم إعادته عند محاكاة النشاط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O kolik pixelů se má kurzor při simulaci aktivity posunout a vrátit zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzahl der Pixel, um die der Zeiger beim Simulieren von Aktivität bewegt und wieder zurückbewegt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many pixels to move the cursor and move it back when simulating activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos píxeles mover el cursor y devolverlo a su posición al simular actividad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام شبیه‌سازی فعالیت، نشانگر چند پیکسل جابه‌جا شود و برگردد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de pixels de déplacement aller-retour du pointeur lors de la simulation d’activité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספר הפיקסלים להזזת הסמן ולהחזרתו בעת הדמיית פעילות."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah piksel untuk menggerakkan kursor lalu mengembalikannya saat menyimulasikan aktivitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di quanti pixel spostare il cursore avanti e indietro durante la simulazione dell’attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作のシミュレート時にカーソルを移動して戻すピクセル数です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동을 시뮬레이션할 때 커서를 이동했다가 되돌릴 픽셀 수입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel pixels de aanwijzer heen en terug beweegt bij het simuleren van activiteit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba pikseli, o jaką kursor przesuwa się i wraca podczas symulowania aktywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos pixels o cursor deve se mover e voltar ao simular atividade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul de pixeli cu care se mută cursorul înainte și înapoi la simularea activității."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сколько пикселей сдвинуть курсор и вернуть обратно при имитации активности."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlik taklit edilirken imlecin kaç piksel hareket edip geri döneceği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На скільки пікселів перемістити курсор і повернути його назад під час імітації активності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số pixel con trỏ sẽ di chuyển rồi quay lại khi mô phỏng hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟活动时光标移动再移回的像素数。"
          }
        }
      }
    },
    "behavior.nudge.title": {

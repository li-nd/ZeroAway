    "schedule.always.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء تشغيل جلسة من شريط القوائم، يعمل ZeroAway بلا قيود على الأيام أو الساعات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je relace v řádku nabídek zapnutá, běží ZeroAway bez omezení dnů či hodin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange eine Menüleistensitzung aktiv ist, wird ZeroAway ohne Einschränkung nach Tag oder Uhrzeit ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While a menu bar session is on, ZeroAway runs with no day or hour limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras haya una sesión activa en la barra de menús, ZeroAway se ejecuta sin límites de días ni horarios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی نشست نوار منو روشن است، ZeroAway بدون محدودیت روز یا ساعت اجرا می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu’une session de la barre des menus est active, ZeroAway s’exécute sans restriction de jour ni d’heure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כאשר הפעלה בשורת התפריטים פעילה, ZeroAway פועל ללא הגבלות יום או שעה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat sesi bar menu aktif, ZeroAway berjalan tanpa batasan hari atau jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una sessione è attiva nella barra dei menu, ZeroAway funziona senza limiti di giorni o orari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのセッションがオンの間、ZeroAwayは曜日や時間の制限なく実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 세션이 켜져 있으면 ZeroAway가 요일이나 시간 제한 없이 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer een menubalksessie actief is, wordt ZeroAway uitgevoerd zonder beperkingen voor dagen of uren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy sesja jest włączona na pasku menu, ZeroAway działa bez ograniczeń dni ani godzin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto uma sessão da barra de menus estiver ativa, o ZeroAway funciona sem limites de dias ou horários."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp este activă o sesiune din bara de meniu, ZeroAway rulează fără limite de zi sau oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока включена сессия в строке меню, ZeroAway действует без ограничений по часам и дням."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu oturumu açıkken ZeroAway gün veya saat sınırı olmadan çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли сеанс у смузі меню ввімкнено, ZeroAway працює без обмежень за днями чи годинами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một phiên trên thanh menu được bật, ZeroAway chạy không giới hạn ngày hoặc giờ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏会话开启时，ZeroAway 将随时运行，不受日期或时间限制。"
          }
        }
      }
    },
    "schedule.always.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {

    "stats.collect.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجل مدة الجلسة وعدد مرات تحريك المؤشر. تُخزن على هذا الـ Mac فقط."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenává délku relace a počet posunutí kurzoru. Data se ukládají pouze na tomto Macu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst die Sitzungsdauer und wie oft der Zeiger bewegt wurde. Wird nur auf diesem Mac gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records session length and how many times the cursor was nudged. Stored only on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la duración de la sesión y cuántas veces se movió el cursor. Se guarda solo en esta Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مدت نشست و تعداد دفعات حرکت نشانگر را ثبت می‌کند. داده‌ها فقط در این Mac ذخیره می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre la durée des sessions et le nombre de déplacements du pointeur. Ces données sont stockées uniquement sur ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתעד את משך ההפעלה ואת מספר הפעמים שהסמן הוזז. הנתונים נשמרים רק ב-Mac הזה."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merekam durasi sesi dan berapa kali kursor digerakkan. Hanya disimpan di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la durata delle sessioni e il numero di spostamenti del cursore. I dati restano solo su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション時間とカーソルを動かした回数を記録します。データはこのMacにのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 길이와 커서 이동 횟수를 기록합니다. 이 Mac에만 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreert de sessieduur en hoe vaak de aanwijzer is bewogen. Wordt alleen op deze Mac bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejestruje długość sesji i liczbę ruchów kursora. Dane są przechowywane tylko na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra a duração das sessões e quantas vezes o cursor foi movido. Armazenado apenas neste Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează durata sesiunilor și de câte ori a fost mișcat cursorul. Datele sunt stocate doar pe acest Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает длительность сессий и число сдвигов курсора. Хранится только на этом Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum süresini ve imlecin kaç kez hareket ettirildiğini kaydeder. Yalnızca bu Mac’te saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записує тривалість сеансів і кількість зсувів курсора. Дані зберігаються лише на цьому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại thời lượng phiên và số lần con trỏ được dịch chuyển. Chỉ lưu trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录会话时长和光标微移次数。数据仅存储在此 Mac 上。"
          }
        }
      }
    },

    "system.accessibility.needed_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ ZeroAway إعادة تعيين خمول النظام دون الوصول إلى تسهيلات الاستخدام. اسمح بذلك في الخصوصية والأمن."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez přístupu ke zpřístupnění nemůže ZeroAway vynulovat dobu nečinnosti systému. Povolte jej v Soukromí a zabezpečení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Zugriff auf Bedienungshilfen kann ZeroAway die Systeminaktivität nicht zurücksetzen. Erlauben Sie den Zugriff unter „Datenschutz & Sicherheit“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Accessibility access, ZeroAway can’t reset system idle. Allow it in Privacy & Security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a Accesibilidad, ZeroAway no puede reiniciar la inactividad del sistema. Permítelo en Privacidad y seguridad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون مجوز دسترسی‌پذیری، ZeroAway نمی‌تواند بی‌کاری سیستم را بازنشانی کند. در «حریم خصوصی و امنیت» اجازه دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès à Accessibilité, ZeroAway ne peut pas réinitialiser l’inactivité système. Autorisez-le dans Confidentialité et sécurité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ללא גישה לנגישות, ZeroAway אינו יכול לאפס את חוסר הפעילות של המערכת. אפשרו אותה תחת ״פרטיות ואבטחה״."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akses Aksesibilitas, ZeroAway tidak dapat mengatur ulang waktu diam sistem. Izinkan di Privasi & Keamanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza l’accesso ad Accessibilità, ZeroAway non può azzerare l’inattività di sistema. Consentilo in Privacy e Sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティが許可されていないと、ZeroAwayはシステムのアイドル状態をリセットできません。「プライバシーとセキュリティ」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 없으면 ZeroAway가 시스템 유휴 시간을 재설정할 수 없습니다. 개인정보 보호 및 보안에서 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder toegang tot Toegankelijkheid kan ZeroAway de systeeminactiviteit niet opnieuw instellen. Sta dit toe in Privacy en beveiliging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez dostępu do ułatwień ZeroAway nie może zerować bezczynności systemu. Zezwól na to w sekcji Prywatność i ochrona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso à Acessibilidade, o ZeroAway não pode zerar a inatividade do sistema. Permita o acesso em Privacidade e Segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără acces la Accesibilitate, ZeroAway nu poate reseta inactivitatea sistemului. Permite accesul în Intimitate și securitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без Универсального доступа ZeroAway не может сбрасывать idle. Разрешите его в Конфиденциальности и безопасности."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroAway, Erişilebilirlik erişimi olmadan sistemin boşta kalma süresini sıfırlayamaz. Gizlilik ve Güvenlik’te izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без універсального доступу ZeroAway не може скидати системну бездіяльність. Надайте його в розділі «Приватність і безпека»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không có quyền Trợ năng, ZeroAway không thể đặt lại trạng thái không hoạt động của hệ thống. Hãy cho phép trong Quyền riêng tư & Bảo mật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有辅助功能权限，ZeroAway 无法重置系统闲置状态。请在“隐私与安全性”中允许访问。"
          }
        }
      }
    },

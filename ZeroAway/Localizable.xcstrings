    "stats.clear.caption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف كل الجلسات المخزنة نهائيًا. تبدأ الجلسة الحالية، إن وجدت، من جديد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trvale smaže všechny uložené relace. Aktuální relace, pokud existuje, začne znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gespeicherten Sitzungen dauerhaft löschen. Eine ggf. aktive Sitzung beginnt von vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete all stored sessions. The current session, if any, starts fresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente todas las sesiones guardadas. La sesión actual, si existe, comienza desde cero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه نشست‌های ذخیره‌شده را برای همیشه حذف می‌کند. نشست فعلی، در صورت وجود، از نو آغاز می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement toutes les sessions enregistrées. La session actuelle, le cas échéant, repart de zéro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקה לצמיתות של כל ההפעלות שנשמרו. ההפעלה הנוכחית, אם קיימת, תתחיל מחדש."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus permanen semua sesi yang tersimpan. Sesi saat ini, jika ada, dimulai dari awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente tutte le sessioni archiviate. La sessione attuale, se presente, riparte da zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されているすべてのセッションを完全に削除します。現在のセッションがある場合は、新たに記録を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모든 세션을 영구적으로 삭제합니다. 현재 세션이 있다면 새로 시작됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder alle bewaarde sessies permanent. De huidige sessie begint opnieuw, indien van toepassing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usuń wszystkie zachowane sesje. Bieżąca sesja, jeśli trwa, rozpocznie się od nowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga permanentemente todas as sessões armazenadas. A sessão atual, se houver, recomeça do zero."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge definitiv toate sesiunile salvate. Sesiunea curentă, dacă există, reîncepe de la zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет все сохранённые сессии. Текущая сессия, если есть, начнётся заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklanan tüm oturumları kalıcı olarak siler. Varsa geçerli oturum baştan başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назавжди видалити всі збережені сеанси. Поточний сеанс, якщо він є, почнеться заново."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa vĩnh viễn tất cả các phiên đã lưu. Phiên hiện tại, nếu có, sẽ bắt đầu lại từ đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除所有已存储的会话。当前会话（如有）将重新开始记录。"
          }
        }
      }
    },

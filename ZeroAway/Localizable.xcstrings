    "notifications.session_ended.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الخمول، قد تظهر مجددًا بالحالة «بعيد»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při nečinnosti se váš stav může opět změnit na Pryč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Inaktivität werden Sie möglicherweise wieder als abwesend angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When idle, you may appear Away again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando estés inactivo, podrías volver a aparecer como Ausente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام بی‌کاری ممکن است دوباره وضعیت شما «دور» نمایش داده شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d’inactivité, vous pourriez de nouveau apparaître Absent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בעת חוסר פעילות, ייתכן ששוב תופיעו כלא זמינים."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat diam, status Anda mungkin kembali terlihat Tidak di Tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sei inattivo, potresti apparire di nuovo Assente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイドル状態になると、再び離席中と表示される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유휴 상태가 되면 다시 자리 비움으로 표시될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je inactief bent, kun je weer als Afwezig verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas bezczynności Twój status może znów zmienić się na „Zaraz wracam”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando estiver inativo, você poderá aparecer como Ausente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când ești inactiv, este posibil să apari din nou ca absent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При простое снова можете оказаться в статусе «отошёл»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boştayken yeniden Uzakta görünebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час бездіяльності ваш статус знову може змінитися на «Відійшов»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi không hoạt động, bạn có thể lại hiển thị là Vắng mặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闲置时，你可能会再次显示为“离开”。"
          }
        }
      }
    },
